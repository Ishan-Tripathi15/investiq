# Market data
# Store the real key only in your deployment secret store.
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
MARKET_DATA_TIMEOUT_MS=8000
MARKET_DATA_CACHE_TTL_SECONDS=300

# Persistence
DATABASE_URL=postgresql://investiq:investiq@localhost:5432/investiq
REDIS_URL=redis://localhost:6379

# Authentication
# Use a random secret of at least 32 characters. Never commit the real value.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=investiq-api
AUTH_JWT_AUDIENCE=investiq-mobile
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
# JSON array of users. Password hashes use: scrypt$<salt>$<64-byte-hex-derived-key>.
# Example shape only; do not use example credentials in production.
AUTH_USERS_JSON=[]

# Broker execution
# Supported provider: zerodha. Leave empty to keep execution fail-closed.
BROKER_PROVIDER=
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=
# 32-byte encryption key encoded as 64 hexadecimal characters. Keep only in a secret manager.
BROKER_TOKEN_ENCRYPTION_KEY=

# Field-level encryption for customer profile/KYC data.
# 32-byte key encoded as 64 hexadecimal characters. Never commit the real value.
DATA_ENCRYPTION_KEY=

# Trading risk controls
TRADING_MAX_ORDER_QUANTITY=10000
TRADING_MAX_ORDER_NOTIONAL=1000000
TRADING_MAX_OPEN_ORDERS_PER_SYMBOL=5
TRADING_REQUIRE_PRICE_FOR_BUYING_POWER=true
